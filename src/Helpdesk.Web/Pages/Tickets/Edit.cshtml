@page "{id:int}"
@model Helpdesk.Web.Pages.Tickets.EditModel
@{
    ViewData["Title"] = "Edycja zgłoszenia";
}

<h1 class="h3 mb-3">Edycja zgłoszenia</h1>

<form method="post" class="col-lg-8">
    <partial name="_TicketForm" model="Model.Input" />
    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    <a asp-page="Index" class="btn btn-link">Anuluj</a>
</form>
