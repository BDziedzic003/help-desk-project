@page
@using Helpdesk.Web.Infrastructure
@model Helpdesk.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Użytkownicy";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Użytkownicy</h1>
    <a asp-page="Create" class="btn btn-primary">Nowy użytkownik</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white border">
        <thead>
            <tr>
                <th>Nazwa użytkownika</th>
                <th>Rola</th>
                <th>Zgłoszenia</th>
                <th class="text-end">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td><span class="badge @user.Role.ToBadgeClass()">@user.Role.ToDisplayName()</span></td>
                    <td>@user.TicketCount</td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edytuj</a>
                        @if (user.Id != Model.CurrentUserId)
                        {
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
