@page
@{
    ViewData["Title"] = "Strona główna";
}

<h1 class="h3">Helpdesk</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p class="text-muted">Zalogowano jako <strong>@User.Identity.Name</strong>.</p>
}
else
{
    <p class="text-muted">System zgłoszeń. Zaloguj się, aby kontynuować.</p>
    <a asp-page="/Account/Login" class="btn btn-primary">Zaloguj się</a>
}
